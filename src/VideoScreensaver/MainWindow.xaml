<Window
    x:Class="VideoScreensaver.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:VideoScreensaver"
    Title="Video Screensaver - Galería y Configuración">

    <Grid x:Name="Root" RowSpacing="18" Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header & Global Actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="Video Screensaver" Style="{StaticResource TitleTextBlockStyle}" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Explora vídeos en alta calidad de Pixabay o de tus carpetas locales y crea tu lista de reproducción favorita."
                           Style="{StaticResource BodyTextBlockStyle}" Opacity="0.75" FontSize="14" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <ToggleSwitch x:Name="ShuffleToggle" Header="Modo de reproducción" OnContent="Aleatorio (Shuffle Loop)" OffContent="Secuencial (Loop)" />
                <ToggleSwitch x:Name="MuteToggle" Header="Sonido" OnContent="Silenciado" OffContent="Con audio" />
                <StackPanel Width="180" VerticalAlignment="Bottom">
                    <TextBlock x:Name="FadeDurationLabel" Text="Duración del crossfade: 6.0 s" FontSize="12" Opacity="0.75" />
                    <Slider x:Name="FadeDurationSlider" Minimum="1" Maximum="10" StepFrequency="0.5"
                            ValueChanged="FadeDurationSlider_ValueChanged" />
                </StackPanel>
                <Button x:Name="TestButton" Style="{StaticResource AccentButtonStyle}" Click="TestButton_Click" VerticalAlignment="Bottom" Padding="14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE768;" />
                        <TextBlock Text="Probar salvapantallas" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation Tabs -->
        <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Top" IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed" SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavPlaylist" Content="Lista de Reproducción (0)" Tag="playlist" Icon="Play" FontSize="14" />
                <NavigationViewItem x:Name="NavPixabay" Content="Explorar Pixabay" Tag="pixabay" Icon="Globe" FontSize="14" />
                <NavigationViewItem x:Name="NavLocal" Content="Carpeta Local" Tag="local" Icon="Folder" FontSize="14" />
            </NavigationView.MenuItems>
        </NavigationView>

        <!-- Main Content Area -->
        <Grid Grid.Row="2">
            <!-- TAB 1: Playlist -->
            <Grid x:Name="PlaylistView" Visibility="Visible" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="Vídeos activos en el salvapantallas" Style="{StaticResource SubtitleTextBlockStyle}" FontWeight="SemiBold" />
                        <TextBlock x:Name="PlaylistCountBadge" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ClearPlaylistButton" Content="Vaciar lista" Click="ClearPlaylistButton_Click" />
                    </StackPanel>
                </Grid>

                <GridView x:Name="PlaylistGrid" Grid.Row="1" SelectionMode="None"
                          CanReorderItems="True" AllowDrop="True" CanDragItems="True"
                          DragItemsCompleted="PlaylistGrid_DragItemsCompleted">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:PlaylistItem">
                            <Grid Width="270" Height="255" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Margin="0,0,16,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="145" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Media Preview / Thumbnail Container -->
                                <Grid Grid.Row="0" CornerRadius="8" Background="Black"
                                      PointerEntered="VideoCard_PointerEntered" PointerExited="VideoCard_PointerExited"
                                      DoubleTapped="VideoCard_DoubleTapped"
                                      Tag="{x:Bind VideoUri}">
                                    <Image Source="{x:Bind SafeImageSource(ThumbnailUri)}" Stretch="UniformToFill" />
                                    <MediaPlayerElement x:Name="HoverPlayer" Stretch="UniformToFill" AutoPlay="False"
                                                        AreTransportControlsEnabled="False" Visibility="Collapsed" />
                                    <Border Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Padding="6,3" Margin="6" CornerRadius="4" Visibility="{x:Bind VisibleIfHasText(DurationText)}">
                                        <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Background="#99000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Padding="6,3" Margin="6" CornerRadius="4">
                                        <TextBlock Text="{x:Bind Tags}" FontSize="11" Foreground="White" />
                                    </Border>
                                </Grid>

                                <!-- Info -->
                                <StackPanel Grid.Row="1" Spacing="2" Margin="0,6,0,0">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind DurationText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" Visibility="{x:Bind VisibleIfHasText(DurationText)}" />
                                </StackPanel>

                                <!-- Actions -->
                                <Grid Grid.Row="2" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Reorder Buttons -->
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Button ToolTipService.ToolTip="Mover hacia arriba / anterior"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Padding="7,5"
                                                Click="MovePlaylistItemUp_Click"
                                                Tag="{x:Bind Id}">
                                            <FontIcon Glyph="&#xE76B;" FontSize="11" />
                                        </Button>
                                        <Button ToolTipService.ToolTip="Mover hacia abajo / siguiente"
                                                Style="{StaticResource DefaultButtonStyle}"
                                                Padding="7,5"
                                                Click="MovePlaylistItemDown_Click"
                                                Tag="{x:Bind Id}">
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" />
                                        </Button>
                                    </StackPanel>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="2" Content="🗑 Eliminar" Style="{StaticResource DefaultButtonStyle}" FontSize="12"
                                            HorizontalAlignment="Right" Click="RemoveFromPlaylist_Click" Tag="{x:Bind Id}" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Empty state for playlist -->
                <StackPanel x:Name="EmptyPlaylistState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="14" Visibility="Collapsed">
                    <FontIcon Glyph="&#xE714;" FontSize="52" Opacity="0.4" />
                    <TextBlock Text="Tu lista de reproducción está vacía" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                    <TextBlock Text="Explora vídeos en la pestaña 'Explorar Pixabay' o añade archivos desde 'Carpeta Local' para empezar."
                               Opacity="0.75" TextAlignment="Center" MaxWidth="440" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- TAB 2: Pixabay Gallery -->
            <Grid x:Name="PixabayView" Visibility="Collapsed" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search & Filters -->
                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*" />
                        <ColumnDefinition Width="1.8*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="PixabaySearchBox" PlaceholderText="Buscar en Pixabay (ej. paisajes, galaxia, lluvia, fuego)..." KeyDown="PixabaySearchBox_KeyDown" />
                    <ComboBox x:Name="PixabayCategoryCombo" Grid.Column="1" HorizontalAlignment="Stretch"
                              DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectionChanged="PixabayCategoryCombo_SelectionChanged" />
                    <Button Grid.Column="2" Content="Buscar" Style="{StaticResource AccentButtonStyle}" Click="PixabaySearchButton_Click" Padding="16,6" />
                    <Button Grid.Column="3" Content="API Key" Click="ApiKeyButton_Click">
                        <Button.Flyout>
                            <Flyout>
                                <StackPanel Spacing="8" Width="320">
                                    <TextBlock Text="Clave API de Pixabay" FontWeight="SemiBold" />
                                    <TextBlock Text="Necesaria para buscar vídeos de Pixabay. Consigue una clave gratuita en pixabay.com/api/docs (requiere una cuenta gratuita)." Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" TextWrapping="Wrap" />
                                    <TextBox x:Name="PixabayApiKeyBox" PlaceholderText="Tu API Key" />
                                    <Button Content="Guardar clave" HorizontalAlignment="Right" Click="SaveApiKey_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </Grid>

                <!-- Pixabay Results Grid -->
                <GridView x:Name="PixabayGrid" Grid.Row="1" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:VideoGalleryItem">
                            <Grid Width="270" Height="265" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Margin="0,0,16,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="145" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Hover video preview -->
                                <Grid Grid.Row="0" CornerRadius="8" Background="Black"
                                      PointerEntered="VideoCard_PointerEntered" PointerExited="VideoCard_PointerExited"
                                      DoubleTapped="VideoCard_DoubleTapped"
                                      Tag="{x:Bind PreviewUri}">
                                    <Image Source="{x:Bind SafeImageSource(ThumbnailUri)}" Stretch="UniformToFill" />
                                    <MediaPlayerElement x:Name="HoverPlayer" Stretch="UniformToFill" AutoPlay="False"
                                                        AreTransportControlsEnabled="False" Visibility="Collapsed" />
                                    <Border Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Padding="6,3" Margin="6" CornerRadius="4" Visibility="{x:Bind VisibleIfHasText(DurationText)}">
                                        <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Background="#99000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            Padding="6,3" Margin="6" CornerRadius="4">
                                        <TextBlock Text="{x:Bind Tags}" FontSize="11" Foreground="White" />
                                    </Border>
                                    <Border Background="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Padding="7,4" Margin="6" CornerRadius="4" Visibility="{x:Bind VisibleIf(IsInPlaylist), Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="White" />
                                            <TextBlock Text="En la lista" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="2" Margin="0,6,0,0">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                                </StackPanel>

                                <Button Grid.Row="2" Content="➕ Añadir a la lista" Style="{StaticResource DefaultButtonStyle}" FontSize="12"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="AddGalleryItem_Click" Tag="{x:Bind Id}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Progress Ring -->
                <ProgressRing x:Name="PixabayLoadingRing" Grid.Row="1" Width="52" Height="52"
                              HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" />

                <!-- Pagination Bar -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                        <Button x:Name="PrevPageButton" Content="◀ Anterior" Click="PrevPageButton_Click" IsEnabled="False" />
                        <TextBlock x:Name="PageIndicatorText" Text="Página 1 de 1" VerticalAlignment="Center" FontWeight="SemiBold" />
                        <Button x:Name="NextPageButton" Content="Siguiente ▶" Click="NextPageButton_Click" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- TAB 3: Local Gallery -->
            <Grid x:Name="LocalView" Visibility="Collapsed" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderTextBox" PlaceholderText="Selecciona una carpeta con archivos de vídeo (.mp4, .mov, .wmv, .avi)" TextChanged="FolderTextBox_TextChanged" />
                    <Button Grid.Column="1" Content="Examinar..." Click="BrowseButton_Click" />
                    <Button Grid.Column="2" x:Name="AddAllLocalButton" Content="Añadir todos a la lista" Style="{StaticResource AccentButtonStyle}" Click="AddAllLocalButton_Click" />
                </Grid>

                <GridView x:Name="LocalGrid" Grid.Row="1" SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:VideoGalleryItem">
                            <Grid Width="270" Height="265" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Margin="0,0,16,16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="145" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" CornerRadius="8" Background="#111"
                                                      PointerEntered="VideoCard_PointerEntered" PointerExited="VideoCard_PointerExited"
                                                      DoubleTapped="VideoCard_DoubleTapped"
                                                      Tag="{x:Bind PreviewUri}">
                                                    <FontIcon Glyph="&#xE714;" FontSize="36" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    <Image Source="{x:Bind SafeImageSource(ThumbnailUri)}" Stretch="UniformToFill" />
                                                                    <MediaPlayerElement x:Name="HoverPlayer" Stretch="UniformToFill" AutoPlay="False"
                                                                                        AreTransportControlsEnabled="False" Visibility="Collapsed" />
                                                                    <Border Background="#99000000" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                                            Padding="6,3" Margin="6" CornerRadius="4" Visibility="{x:Bind VisibleIfHasText(DurationText)}">
                                                                        <TextBlock Text="{x:Bind DurationText}" FontSize="11" Foreground="White" />
                                                                    </Border>
                                                                    <Border Background="#99000000" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                                            Padding="6,3" Margin="6" CornerRadius="4">
                                                                        <TextBlock Text="{x:Bind Tags}" FontSize="11" Foreground="White" />
                                                                    </Border>
                                                                </Grid>

                                <StackPanel Grid.Row="1" Spacing="2" Margin="0,6,0,0">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    <TextBlock Text="{x:Bind Subtitle}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.75" />
                                </StackPanel>

                                <Button Grid.Row="2" Content="➕ Añadir a la lista" Style="{StaticResource DefaultButtonStyle}" FontSize="12"
                                        HorizontalAlignment="Stretch" Margin="0,6,0,0" Click="AddGalleryItem_Click" Tag="{x:Bind Id}" />
                            </Grid>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <StackPanel x:Name="EmptyLocalState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" Visibility="Collapsed">
                    <FontIcon Glyph="&#xED43;" FontSize="44" Opacity="0.4" />
                    <TextBlock Text="No se encontraron vídeos en esta carpeta" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
                    <TextBlock Text="Haz clic en 'Examinar' para elegir una carpeta con vídeos compatibles."
                               Opacity="0.75" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Bottom Notification InfoBar -->
        <InfoBar x:Name="NotificationInfoBar" Grid.Row="3" IsOpen="False" Severity="Success" />
    </Grid>
</Window>
