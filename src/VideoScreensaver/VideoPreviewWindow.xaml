<Window
    x:Class="VideoScreensaver.VideoPreviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Black" KeyDown="Root_KeyDown" KeyUp="Root_KeyUp">
        <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True"
                             AutoPlay="False" Stretch="Uniform" />

        <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Spacing="14">
            <ProgressRing IsActive="True" Width="48" Height="48" />
            <TextBlock x:Name="LoadingText" Text="Preparando vídeo…" Foreground="White"
                       FontSize="16" HorizontalAlignment="Center" />
        </StackPanel>

        <Button x:Name="CloseButton" Content="✕ Cerrar (Esc)" Click="CloseButton_Click"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                Background="#99000000" Foreground="White" BorderThickness="0" Padding="14,8" />
    </Grid>
</Window>
